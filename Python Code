# 6 DOF robot arm simulation
# - forward kinematics (joint angles -> where the gripper is)
# - inverse kinematics (where I want the gripper -> joint angles)
# - smooth motion between points
# - 3D animation of a pick and place
#
# run it:  python arm6dof.py
# or save a gif:  python arm6dof.py --save arm.gif
# needs:  pip install numpy matplotlib

import argparse
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation, PillowWriter


def dh_matrix(theta, d, a, alpha):
    # 4x4 transform for one link from the DH parameters
    ct = np.cos(theta)
    st = np.sin(theta)
    ca = np.cos(alpha)
    sa = np.sin(alpha)
    return np.array([
        [ct, -st * ca,  st * sa, a * ct],
        [st,  ct * ca, -ct * sa, a * st],
        [0,        sa,       ca,      d],
        [0,         0,        0,      1],
    ])


def make_pose(x, y, z, R):
    # put a position and a rotation matrix into one 4x4 matrix
    T = np.eye(4)
    T[:3, :3] = R
    T[:3, 3] = [x, y, z]
    return T


def rotation_error(R_current, R_target):
    # gives a 3 vector for how far off the rotation is
    R = R_target @ R_current.T
    return 0.5 * np.array([R[2, 1] - R[1, 2],
                           R[0, 2] - R[2, 0],
                           R[1, 0] - R[0, 1]])


def quintic(t):
    # goes smoothly from 0 to 1, starts and ends slow
    return 10 * t**3 - 15 * t**4 + 6 * t**5


class Arm6DOF:
    def __init__(self):
        # DH table, one number per joint (meters and radians)
        self.d = np.array([0.30, 0.00, 0.00, 0.30, 0.00, 0.10])
        self.a = np.array([0.00, 0.35, 0.00, 0.00, 0.00, 0.00])
        self.alpha = np.array([np.pi / 2, 0, np.pi / 2, -np.pi / 2, np.pi / 2, 0])
        self.offset = np.array([0, np.pi / 2, 0, 0, 0, 0])

        # joint limits in degrees, converted to radians
        limits = np.deg2rad(np.array([170, 120, 150, 170, 120, 170]))
        self.q_min = -limits
        self.q_max = limits

    def forward(self, q):
        # returns 7 frames: the base and then one after each joint
        T = np.eye(4)
        frames = [T]
        for i in range(6):
            T = T @ dh_matrix(q[i] + self.offset[i], self.d[i], self.a[i], self.alpha[i])
            frames.append(T)
        return frames

    def end_pose(self, q):
        return self.forward(q)[-1]

    def jacobian(self, q):
        # 6x6 jacobian, tells us how joint speeds change the gripper speed
        frames = self.forward(q)
        p_end = frames[-1][:3, 3]
        J = np.zeros((6, 6))
        for i in range(6):
            z = frames[i][:3, 2]   # axis of this joint
            p = frames[i][:3, 3]   # where this joint is
            J[:3, i] = np.cross(z, p_end - p)
            J[3:, i] = z
        return J

    def inverse(self, T_target, q_start, max_iter=300, tol_pos=1e-4, tol_rot=1e-3,
                damping=0.05, max_step=0.3):
        # numerical IK (damped least squares)
        # start from q_start and move the joints a little bit each loop
        # until the gripper gets to the target
        # returns (q, success)
        q = np.array(q_start, dtype=float)

        for i in range(max_iter):
            T = self.end_pose(q)
            pos_err = T_target[:3, 3] - T[:3, 3]
            rot_err = rotation_error(T[:3, :3], T_target[:3, :3])
            err = np.hstack([pos_err, rot_err])

            # close enough, we're done
            if np.linalg.norm(pos_err) < tol_pos and np.linalg.norm(rot_err) < tol_rot:
                return q, True

            J = self.jacobian(q)
            dq = J.T @ np.linalg.solve(J @ J.T + damping**2 * np.eye(6), err)

            # limit the step size so the arm doesn't jump around
            biggest = np.max(np.abs(dq))
            if biggest > max_step:
                dq = dq * (max_step / biggest)

            q = np.clip(q + dq, self.q_min, self.q_max)

        return q, False


def joint_trajectory(q_from, q_to, steps=40):
    # smooth move in joint space from q_from to q_to
    s = quintic(np.linspace(0, 1, steps))[:, None]
    return q_from + s * (q_to - q_from)


