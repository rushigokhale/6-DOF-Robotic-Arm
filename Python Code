def build_demo(arm):
    # pick and place. each waypoint is a gripper position with the tool pointing down
    R_down = np.diag([1.0, -1.0, -1.0])
    waypoints = {
        "above pick":  (0.40,  0.15, 0.30),
        "pick":        (0.40,  0.15, 0.12),
        "lift":        (0.40,  0.15, 0.30),
        "above place": (0.25, -0.35, 0.30),
        "place":       (0.25, -0.35, 0.12),
        "retreat":     (0.25, -0.35, 0.30),
    }

    q = np.deg2rad([0, 30, 60, 0, 60, 0])   # home pose, also the first guess for IK
    path = [q.copy()]

    print(f"{'waypoint':<12} {'ok':<5} {'pos error (mm)':>14}")
    for name, (x, y, z) in waypoints.items():
        target = make_pose(x, y, z, R_down)
        q_new, ok = arm.inverse(target, q)

        err_mm = 1000 * np.linalg.norm(arm.end_pose(q_new)[:3, 3] - target[:3, 3])
        print(f"{name:<12} {str(ok):<5} {err_mm:>14.3f}")

        if not ok:
            raise SystemExit("IK failed for " + name + ", target might be out of reach")

        path.extend(joint_trajectory(q, q_new)[1:])
        q = q_new

    return np.array(path)


def animate(arm, path, save=None):
    fig = plt.figure(figsize=(7, 6))
    ax = fig.add_subplot(111, projection="3d")
    ax.set_xlim(-0.7, 0.7)
    ax.set_ylim(-0.7, 0.7)
    ax.set_zlim(0, 0.9)
    ax.set_xlabel("x (m)")
    ax.set_ylabel("y (m)")
    ax.set_zlabel("z (m)")
    ax.set_title("6-DOF arm: pick and place")

    links, = ax.plot([], [], [], "o-", lw=4, ms=7, color="tab:blue")   # the arm
    trail, = ax.plot([], [], [], "-", lw=1.5, color="tab:orange")      # path of the gripper
    # little red/green/blue lines for the gripper x, y, z axes
    tool = [ax.plot([], [], [], c, lw=2)[0] for c in ("r", "g", "b")]
    tip_history = []

    def update(k):
        frames = arm.forward(path[k])
        pts = np.array([f[:3, 3] for f in frames])
        links.set_data(pts[:, 0], pts[:, 1])
        links.set_3d_properties(pts[:, 2])

        tip = pts[-1]
        tip_history.append(tip)
        h = np.array(tip_history)
        trail.set_data(h[:, 0], h[:, 1])
        trail.set_3d_properties(h[:, 2])

        for col in range(3):
            end = tip + 0.06 * frames[-1][:3, col]
            tool[col].set_data([tip[0], end[0]], [tip[1], end[1]])
            tool[col].set_3d_properties([tip[2], end[2]])

        send_to_hardware(path[k])
        return [links, trail] + tool

    anim = FuncAnimation(fig, update, frames=len(path), interval=40, blit=False, repeat=False)

    if save:
        anim.save(save, writer=PillowWriter(fps=25))
        print("saved", save)
    else:
        plt.show()


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--save", help="save the animation to this .gif file")
    args = parser.parse_args()

    arm = Arm6DOF()
    path = build_demo(arm)
    animate(arm, path, save=args.save)
