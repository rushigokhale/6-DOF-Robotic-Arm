"""
6-DOF robotic arm in Python (simulation).

What this does:
  1. Forward kinematics (FK): joint angles -> where the gripper is.
  2. Inverse kinematics (IK): where you want the gripper -> joint angles.
  3. Trajectory: smooth motion between poses (quintic profile).
  4. 3D animation of a pick-and-place demo.

Run:   python arm6dof.py              (opens the animation window)
       python arm6dof.py --save a.gif (saves a GIF instead)
Needs: pip install numpy matplotlib
"""
import argparse
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation, PillowWriter


# ---------------------------------------------------------------- math helpers
def dh_matrix(theta, d, a, alpha):
    """One link's 4x4 transform from standard Denavit-Hartenberg parameters."""
    ct, st = np.cos(theta), np.sin(theta)
    ca, sa = np.cos(alpha), np.sin(alpha)
    return np.array([
        [ct, -st * ca,  st * sa, a * ct],
        [st,  ct * ca, -ct * sa, a * st],
        [0.0,      sa,       ca,      d],
        [0.0,     0.0,      0.0,    1.0],
    ])


def make_pose(x, y, z, R):
    """Build a 4x4 pose from a position and a 3x3 rotation matrix."""
    T = np.eye(4)
    T[:3, :3] = R
    T[:3, 3] = [x, y, z]
    return T


def rotation_error(R_current, R_target):
    """Small 3-vector that points along the axis needed to rotate current -> target."""
    R = R_target @ R_current.T
    return 0.5 * np.array([R[2, 1] - R[1, 2], R[0, 2] - R[2, 0], R[1, 0] - R[0, 1]])


def quintic(t):
    """Smooth 0 -> 1 profile with zero velocity and acceleration at both ends."""
    return 10 * t**3 - 15 * t**4 + 6 * t**5


# ------------------------------------------------------------------- the arm
class Arm6DOF:
    def __init__(self):
        # DH table, one entry per joint (meters and radians).
        self.d = np.array([0.30, 0.00, 0.00, 0.30, 0.00, 0.10])
        self.a = np.array([0.00, 0.35, 0.00, 0.00, 0.00, 0.00])
        self.alpha = np.array([np.pi / 2, 0.0, np.pi / 2, -np.pi / 2, np.pi / 2, 0.0])
        self.offset = np.array([0.0, np.pi / 2, 0.0, 0.0, 0.0, 0.0])
        # Joint limits (radians).
        lim = np.deg2rad(np.array([170, 120, 150, 170, 120, 170]))
        self.q_min, self.q_max = -lim, lim

    def forward(self, q):
        """Return the list of 7 frames: base, then after each of the 6 joints."""
        T = np.eye(4)
        frames = [T]
        for i in range(6):
            T = T @ dh_matrix(q[i] + self.offset[i], self.d[i], self.a[i], self.alpha[i])
            frames.append(T)
        return frames

    def end_pose(self, q):
        return self.forward(q)[-1]

    def jacobian(self, q):
        """6x6 geometric Jacobian: how joint speeds change gripper speed."""
        frames = self.forward(q)
        p_end = frames[-1][:3, 3]
        J = np.zeros((6, 6))
        for i in range(6):
            z = frames[i][:3, 2]          # axis of joint i+1
            p = frames[i][:3, 3]          # origin of that joint
            J[:3, i] = np.cross(z, p_end - p)
            J[3:, i] = z
        return J

    def inverse(self, T_target, q_start, max_iter=300, tol_pos=1e-4, tol_rot=1e-3,
                damping=0.05, max_step=0.3):
        """
        Numerical IK (damped least squares). Starts from q_start and nudges the
        joints a little each iteration until the gripper reaches T_target.
        Returns (q, success).
        """
        q = np.array(q_start, dtype=float)
        for _ in range(max_iter):
            T = self.end_pose(q)
            err = np.hstack([T_target[:3, 3] - T[:3, 3],
                             rotation_error(T[:3, :3], T_target[:3, :3])])
            if np.linalg.norm(err[:3]) < tol_pos and np.linalg.norm(err[3:]) < tol_rot:
                return q, True
            J = self.jacobian(q)
            dq = J.T @ np.linalg.solve(J @ J.T + damping**2 * np.eye(6), err)
            biggest = np.max(np.abs(dq))
            if biggest > max_step:                     # don't take huge jumps
                dq *= max_step / biggest
            q = np.clip(q + dq, self.q_min, self.q_max)
        return q, False


# ------------------------------------------------------------- trajectory
def joint_trajectory(q_from, q_to, steps=40):
    """Smooth joint-space move from q_from to q_to."""
    s = quintic(np.linspace(0.0, 1.0, steps))[:, None]
    return q_from + s * (q_to - q_from)


